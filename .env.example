# ──── App Settings ────
SECRET_KEY=dev-secret-change-me-in-production
TZ=Europe/Madrid
LOG_LEVEL=INFO

# ──── Authentication ────
# Set AUTH_ENABLED=true and configure password for production
AUTH_USER=admin
AUTH_PASSWORD_HASH=admin

# ──── STB Credentials (if using Enigma2) ────
# STB_PASSWORD=your_stb_password

# ──── Paths ────
CONFIG_DIR=./config
DATA_DIR=./data
